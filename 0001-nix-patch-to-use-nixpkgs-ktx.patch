From 24570439173ad7c83b182a1ad132823616a0930c Mon Sep 17 00:00:00 2001
From: grindhold <grindhold@gmx.net>
Date: Sat, 7 Dec 2024 15:25:05 +0100
Subject: [PATCH] nix: patch to use nixpkgs ktx

---
 .gitmodules                   |  5 -----
 CMakeLists.txt                |  3 +--
 lib/source/ShaderCompiler.cpp |  6 +++---
 thirdparty/KTX-Software       |  1 -
 thirdparty/KTX-Software.cmake | 34 ----------------------------------
 5 files changed, 4 insertions(+), 45 deletions(-)
 delete mode 160000 thirdparty/KTX-Software
 delete mode 100644 thirdparty/KTX-Software.cmake

diff --git a/.gitmodules b/.gitmodules
index c55061a..b1b8003 100644
--- a/.gitmodules
+++ b/.gitmodules
@@ -4,8 +4,3 @@
 [submodule "thirdparty/glslang"]
 	path = thirdparty/glslang
 	url = https://github.com/KhronosGroup/glslang.git
-[submodule "thirdparty/KTX-Software"]
-    path = thirdparty/KTX-Software
-    url = https://github.com/KhronosGroup/KTX-Software.git
-    branch = master
-	fetchrecursesubmodules = true
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0b22aaa..e6c169e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -113,8 +113,7 @@ target_link_libraries(GltfIblSampler PRIVATE glslang SPIRV)
 target_link_libraries(GltfIblSampler PRIVATE Vulkan::Vulkan)
 
 # libktx
-include(thirdparty/KTX-Software.cmake)
-target_link_libraries(GltfIblSampler PRIVATE Ktx::ktx)
+target_link_libraries(GltfIblSampler PUBLIC ktx)
 
 #cli project
 add_sources("cli/source/*.cpp" "cli_sources")
diff --git a/lib/source/ShaderCompiler.cpp b/lib/source/ShaderCompiler.cpp
index ef2650a..0778220 100644
--- a/lib/source/ShaderCompiler.cpp
+++ b/lib/source/ShaderCompiler.cpp
@@ -131,8 +131,8 @@ bool IBLLib::ShaderCompiler::compile(const std::string& _glslBlob, const char* _
 
 	if (shader.parse(&DefaultTBuiltInResource, 450, false, EShMsgDefault) == false)
 	{
-		printf(shader.getInfoDebugLog());
-		printf(shader.getInfoLog());
+		printf("%s\n",shader.getInfoDebugLog());
+		printf("%s\n",shader.getInfoLog());
 		return false;
 	}
 
@@ -160,7 +160,7 @@ bool IBLLib::ShaderCompiler::compile(const std::string& _glslBlob, const char* _
 
 	glslang::GlslangToSpv(*pIntermediate, _outSpvBlob, &logger, &spvOptions);
 
-	printf(logger.getAllMessages().c_str());
+	printf("%s\n",logger.getAllMessages().c_str());
 
 	return true;
 }
diff --git a/thirdparty/KTX-Software b/thirdparty/KTX-Software
deleted file mode 160000
index d1a25c8..0000000
--- a/thirdparty/KTX-Software
+++ /dev/null
@@ -1 +0,0 @@
-Subproject commit d1a25c8a20607a432b2d910a7a761d663c907e8e
diff --git a/thirdparty/KTX-Software.cmake b/thirdparty/KTX-Software.cmake
deleted file mode 100644
index 2a8e760..0000000
--- a/thirdparty/KTX-Software.cmake
+++ /dev/null
@@ -1,34 +0,0 @@
-set(external_project_name "Ktx")
-set(external_project_target_name "ktx")
-set(external_project_path "KTX-Software")
-set(external_project_cmake_args "-DXCODE_CODE_SIGN_IDENTITY="" -DCMAKE_OSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET} -DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}")
-
-if(MSVC)
-    set(lib_name "${external_project_target_name}.dll")
-    set(imp_lib_name "${external_project_target_name}.lib")
-elseif(APPLE)
-    set(lib_name "lib${external_project_target_name}.dylib")
-else()
-    set(lib_name "lib${external_project_target_name}.so")
-endif()
-
-set(imported_target ${external_project_name}::${external_project_target_name})
-
-# use a custom branch of basisu, which allows it being built as library
-include(ExternalProject)
-ExternalProject_Add(${external_project_name}
-    PREFIX ${external_project_name}
-    SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/${external_project_path}
-    CMAKE_ARGS -DCMAKE_INSTALL_PREFIX:PATH=<INSTALL_DIR> -DKTX_FEATURE_TESTS=OFF -DBUILD_TESTING=OFF -DKTX_FEATURE_TOOLS=OFF ${external_project_cmake_args}
-    BUILD_BYPRODUCTS <INSTALL_DIR>/lib/${lib_name} <INSTALL_DIR>/lib/${imp_lib_name}
-    )
-ExternalProject_Get_Property(${external_project_name} install_dir)
-
-file(MAKE_DIRECTORY ${install_dir}/include)
-add_library(${imported_target} SHARED IMPORTED)
-set_target_properties(${imported_target} PROPERTIES
-    IMPORTED_LOCATION ${install_dir}/lib/${lib_name}
-    INTERFACE_INCLUDE_DIRECTORIES ${install_dir}/include
-    IMPORTED_IMPLIB ${install_dir}/lib/${imp_lib_name})
-
-add_dependencies(${imported_target} ${external_project_name})
-- 
2.47.0

